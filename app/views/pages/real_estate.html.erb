  <script>
    // Property Carousel
    let currentProperty = 0;
    const totalProperties = 3;
    const propertyCarousel = document.getElementById('propertyCarousel');
    
    function updatePropertyCarousel() {
      propertyCarousel.style.transform = `translateX(-${currentProperty * 100}%)`;
      // Update dots
      for (let i = 0; i < totalProperties; i++) {
        const dot = document.getElementById(`property-dot-${i}`);
        if (i === currentProperty) {
          dot.classList.add('bg-white');
          dot.classList.remove('bg-white/50');
        } else {
          dot.classList.add('bg-white/50');
          dot.classList.remove('bg-white');
        }
      }
    }
    
    function movePropertyCarousel(direction) {
      currentProperty = (currentProperty + direction + totalProperties) % totalProperties;
      updatePropertyCarousel();
    }
    
    function goToProperty(propertyIndex) {
      currentProperty = propertyIndex;
      updatePropertyCarousel();
    }
    
    // Auto advance properties
    setInterval(() => movePropertyCarousel(1), 6000);
    
    // Initialize first dot as active
    updatePropertyCarousel();
  </script>
