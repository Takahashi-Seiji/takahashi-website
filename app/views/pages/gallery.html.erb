              </svg>
              Priority event booking
            </li>
            <li class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
              </svg>
              Exclusive member events
            </li>
          </ul>
          <button class="w-full bg-accent text-white py-3 rounded-full hover:bg-white hover:text-accent transition-all">
            Join Now
          </button>
        </div>

        <!-- Membership Tier 3 -->
        <div class="bg-white/5 backdrop-blur-md p-8 rounded-lg border border-white/10 hover:border-accent transition-all">
          <h3 class="text-2xl font-bold text-white mb-4">Patron</h3>
          <div class="text-3xl font-bold text-accent mb-6">$250<span class="text-lg text-white/80">/year</span></div>
          <ul class="space-y-4 text-white/80 mb-8">
            <li class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
              </svg>
              All Premium benefits
            </li>
            <li class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
              </svg>
              Private gallery tours
            </li>
            <li class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
              </svg>
              Meet the artists
            </li>
          </ul>
          <button class="w-full bg-accent text-white py-3 rounded-full hover:bg-white hover:text-accent transition-all">
            Join Now
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative py-20">
    <div class="bg-black/80 absolute inset-0"></div>
    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div class="grid md:grid-cols-4 gap-12">
        <div>
          <h3 class="text-xl font-light text-white mb-4 artistic-border border-b-2">Modern Art Gallery</h3>
          <p class="text-gray-400">Celebrating contemporary art and innovation.</p>
        </div>
        <div>
          <h4 class="font-medium text-white mb-4">Quick Links</h4>
          <div class="space-y-2 text-gray-400">
            <p><a href="#" class="hover:text-accent transition-colors">Exhibitions</a></p>
            <p><a href="#" class="hover:text-accent transition-colors">Virtual Tours</a></p>
            <p><a href="#" class="hover:text-accent transition-colors">Events</a></p>
            <p><a href="#" class="hover:text-accent transition-colors">Membership</a></p>
          </div>
        </div>
        <div>
          <h4 class="font-medium text-white mb-4">Contact</h4>
          <div class="space-y-2 text-gray-400">
            <p>123 Art Street</p>
            <p>Gallery District</p>
            <p>New York, NY 10001</p>
            <p>info@modernartgallery.com</p>
          </div>
        </div>
        <div>
          <h4 class="font-medium text-white mb-4">Follow Us</h4>
          <div class="flex space-x-4">
            <a href="#" class="text-gray-400 hover:text-accent transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" class="text-gray-400 hover:text-accent transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
