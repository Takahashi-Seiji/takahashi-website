          <div class="text-3xl font-bold text-accent mb-6">$50<span class="text-lg text-white/80">/year</span></div>
          <ul class="space-y-4 text-white/80 mb-8">
            <li class="flex items-center">
              <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
              </svg>
